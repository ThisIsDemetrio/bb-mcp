# For now, only "local" is available. Means it uses the personal access token.
BB_MODE=local
# Personal Access Token. To be used if BB_MODE=local. Create one here: https://play.buzzerbeater.com/settings/api
BB_PAT=bbpat-XXX
# Base URL of the buzzerbeater API
BB_API_BASE_URL=https://sb1-api.buzzerbeater.com/v1
# Log level. All caps, available values are DEBUG, INFO, WARNING, ERROR, FATAL
LOG_LEVEL=INFO
